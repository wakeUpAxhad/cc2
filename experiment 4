#include <iostream>

using namespace std;

struct ListNode
{
    int val;
    ListNode* next;

    ListNode(int x) : val(x), next(NULL)
    {
    }
};

class Solution
{
public:
    bool isPalindrome(ListNode* head)
    {
        if (!head || !head->next)
            return true;

        ListNode* slow = head;
        ListNode* fast = head;

        while (fast && fast->next)
        {
            slow = slow->next;
            fast = fast->next->next;
        }

        ListNode* prev = NULL;
        ListNode* next = NULL;

        while (slow)
        {
            next = slow->next;
            slow->next = prev;
            prev = slow;
            slow = next;
        }

        while (prev)
        {
            if (head->val != prev->val)
                return false;

            head = head->next;
            prev = prev->next;
        }

        return true;
    }
};

};
